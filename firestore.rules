rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is a mentor
    function isMentor() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mentor';
    }
    
    // Helper function to check if user is a mentee
    function isMentee() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mentee';
    }
    
    // Helper function to check if mentee owns this mentee doc
    function isMenteeOwner(menteeId) {
      return isMentee() && 
             (menteeId == request.auth.uid ||
              (exists(/databases/$(database)/documents/mentees/$(menteeId)) &&
               get(/databases/$(database)/documents/mentees/$(menteeId)).data.userId == request.auth.uid));
    }

    // Users collection - mentors can read/write all, users can read/write their own
    match /users/{userId} {
      allow read: if isAuthenticated() && (isMentor() || request.auth.uid == userId);
      allow write: if isMentor() || request.auth.uid == userId;
    }

    // Leads collection - mentor only
    match /leads/{leadId} {
      allow read, write: if isMentor();
    }

    // Deals collection - mentor only
    match /deals/{dealId} {
      allow read, write: if isMentor();
    }

    // Payments collection - mentor only
    match /payments/{paymentId} {
      allow read, write: if isMentor();
    }

    // Mentees collection
    match /mentees/{menteeId} {
      allow read: if isMentor() || isMenteeOwner(menteeId) || (isAuthenticated() && resource.data.email == request.auth.token.email);
      allow create, delete: if isMentor();
      allow update: if isMentor() || 
                    isMenteeOwner(menteeId) || 
                    (isAuthenticated() && resource.data.email == request.auth.token.email && (resource.data.uid == null || resource.data.uid == "") && request.resource.data.uid == request.auth.uid);
      
      // Subcollections inside mentees
      match /offersMined/{offerId} {
        allow read, write: if isMentor() || isMenteeOwner(menteeId);
      }
      match /miningSummary/{docId} {
        allow read, write: if isMentor() || isMenteeOwner(menteeId);
      }
    }

    // Calls collection - mentors can read/write all, mentees can read their calls
    match /calls/{callId} {
      allow read: if isMentor() || 
                     (isMentee() && exists(/databases/$(database)/documents/mentees/$(resource.data.menteeId)) &&
                      get(/databases/$(database)/documents/mentees/$(resource.data.menteeId)).data.userId == request.auth.uid);
      allow write: if isMentor();
    }

    // Tasks collection - mentors can read/write all, mentees can read/write their own
    match /tasks/{taskId} {
      allow read: if isMentor() || (isMentee() && resource.data.ownerId == request.auth.uid);
      allow write: if isMentor() || (isMentee() && request.resource.data.ownerId == request.auth.uid);
    }

    // Updates collection - mentees can create, mentors can read/write
    match /updates/{updateId} {
      allow read: if isMentor() || (isMentee() && resource.data.submittedByUserId == request.auth.uid);
      allow create: if isMentee() && request.resource.data.submittedByUserId == request.auth.uid;
      allow update, delete: if isMentor();
    }

    // Templates collection - mentor only
    match /templates/{templateId} {
      allow read, write: if isMentor();
    }

    // Media Hub collection - mentor only
    match /mediaFiles/{fileId} {
      allow read, write: if isMentor();
    }

    // Config collection - global settings
    match /config/{document} {
      allow read: if isAuthenticated();
      allow write: if isMentor();
    }
    match /config/{document}/{rest=**} {
      allow read: if isAuthenticated();
      allow write: if isMentor();
    }

    // Message templates
    match /templates_message/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isMentor();
    }

    // Ad Library Offers & Config
    match /adLibraryOffers/{offerId} {
      allow read, write: if isAuthenticated();
    }
    match /adLibraryConfig/{menteeId} {
      allow read, write: if isMentor() || isMenteeOwner(menteeId);
    }

    // Daily Pulse
    match /daily_pulse/{userId}/{rest=**} {
      allow read, write: if isMentor() || request.auth.uid == userId;
    }

    // Transactions / Expenses
    match /transactions/{transactionId} {
      allow read, write: if isAuthenticated();
    }
    match /operational_expenses/{expenseId} {
      allow read, write: if isAuthenticated();
    }
    match /personal_expenses/{expenseId} {
      allow read, write: if isAuthenticated();
    }

    // Offers (Mining Candidates)
    match /offers/{offerId} {
      allow read, write: if isAuthenticated();
    }

    // Traffic / Ads Trackers & Daily Stats
    match /offer_trackers/{trackerId} {
      allow read, write: if isAuthenticated();
    }
    match /daily_stats/{statId} {
      allow read, write: if isAuthenticated();
    }

    // Warming Chips
    match /warming_chips/{chipId} {
      allow read, write: if isAuthenticated();
    }

    // Academy modules, lessons & progress
    match /academy_modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isMentor();
    }
    match /academy_lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isMentor();
    }
    match /mentee_progress/{userId} {
      allow read, write: if isMentor() || request.auth.uid == userId;
    }

    // Contingency Assets
    match /assets/{assetId} {
      allow read, write: if isAuthenticated();
    }

    // Resources
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isMentor();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // Strategy Board
    match /strategyNotes/{noteId} {
      allow read, write: if isAuthenticated();
    }
    match /strategyConnections/{connId} {
      allow read, write: if isAuthenticated();
    }
    match /strategyImages/{imageId} {
      allow read, write: if isAuthenticated();
    }
    match /strategyDrawings/{drawingId} {
      allow read, write: if isAuthenticated();
    }

    // Otimizações Diárias (Public Read)
    match /optimization_days/{dayId} {
      allow read: if true;
      allow write: if isMentor();
    }
    match /optimizations/{optId} {
      allow read: if true;
      allow write: if isMentor();
    }
  }
}
